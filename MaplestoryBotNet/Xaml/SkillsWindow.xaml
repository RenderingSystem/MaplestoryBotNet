<Window x:Class="MaplestoryBotNet.Xaml.SkillsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MaplestoryBotNet.Xaml"
    xmlns:interactivity="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:eo="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
    mc:Ignorable="d"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Title="Rice Krispies"
    Width="500"
    Height="300"
    MaxHeight="300"
    MaxWidth="500"
    MinHeight="300"
    MinWidth="500"
    Background="Black"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Xaml/Resources/ComboBoxResource.xaml"/>
                <ResourceDictionary Source="/Xaml/Resources/ButtonResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Viewbox Stretch="Fill">
        <Grid Width="500" Height="300">
            <TextBox
                x:Name="SkillsMinDelayTextBox"
                Margin="324,204,125,73"
                Text="0"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
                Background="Black"
                Foreground="Lime"
                FontFamily="Courier New"
                TabIndex="1"
            />
            <Label
                Content="Max delay:"
                Margin="375,205,56,0"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Left"
                Foreground="White"
                Height="22"
                FontSize="10"
                FontFamily="Courier New"
            />
            <Button
                x:Name="SkillsAddButton"
                Style="{StaticResource BottingButtonStyle}" 
                Content="Add"
                Margin="29,204,412,73"
                Focusable="False"
                FontFamily="Courier New"
            />
            <Button
                x:Name="SkillsRemoveButton"
                Style="{StaticResource BottingButtonStyle}" 
                Content="Remove"
                Margin="92,204,349,73"
                Focusable="False"
                FontFamily="Courier New"
            />
            <ListBox
                x:Name="SkillsListBox"
                Background="Black"
                Foreground="White"
                Margin="6,22,350,99"
                FontFamily="Courier New"
                FontSize="10"
            >
                <ListBoxItem>
                    <StackPanel
                        x:Name="SkillsListBoxTemplate"
                        Orientation="Horizontal"
                        Focusable="False"
                    >
                        <CheckBox
                            VerticalContentAlignment="Center"
                        />
                        <TextBox
                            Text="Lorem Ipsum"
                            Margin="5,0,0,0"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Left"
                            Width="75"
                            Height="20"
                            Background="Black"
                            Foreground="Lime"
                            FontFamily="Courier New"
                        />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
            <Label
                Content="Skills:"
                FontFamily="Courier New"
                HorizontalAlignment="Left"
                Margin="3,0,0,0"
                VerticalAlignment="Top"
                Width="88"
                FontSize="10"
                Foreground="White"
                Height="22"
            />
            <Button
                x:Name="SkillsSaveButton"
                Style="{StaticResource BottingButtonStyle}" 
                Content="Save"
                Margin="111,265,267,9"
                Focusable="False"
                FontFamily="Courier New"
            />
            <Button
                x:Name="SkillsLoadButton"
                Style="{StaticResource BottingButtonStyle}" 
                Content="Load"
                Margin="264,265,114,9"
                Focusable="False"
                FontFamily="Courier New"
            />
            <TextBox
                x:Name="SkillsMaxDelayTextBox"
                Margin="444,205,5,72"
                Text="0"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
                Background="Black"
                Foreground="Lime"
                FontFamily="Courier New"
                TabIndex="1"
            />
            <Label
                Content="Min delay:"
                Margin="255,204,176,0"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Left"
                Foreground="White"
                Height="22"
                FontSize="10"
                FontFamily="Courier New"
            />
            <ListBox
                x:Name="SkillsMacroListBox"
                Background="Black"
                Foreground="White"
                Margin="155,22,5,99"
                FontFamily="Courier New"
                FontSize="10"
            >
                <ListBoxItem>
                    <ComboBox
                        x:Name="SkillsMacroComboBoxTemplate"
                        Width="288"
                        IsEditable="True"
                        FontSize="10"
                    >
                        <ComboBoxItem Content="Wait {#} {#}"/>
                        <ComboBoxItem Content="Key press {{key}, ...} {#} {#}"/>
                        <ComboBoxItem Content="Key down {key}"/>
                        <ComboBoxItem Content="Key up {key}"/>
                    </ComboBox>
                </ListBoxItem>
            </ListBox>
            <Label
                Content="Macro:"
                FontFamily="Courier New"
                HorizontalAlignment="Left"
                Margin="153,0,0,0"
                VerticalAlignment="Top"
                Width="88"
                FontSize="10"
                Foreground="White"
                Height="22"
            />
            <Button
                x:Name="SkillsAddCommandButton"
                Style="{StaticResource BottingButtonStyle}" 
                Content="+ Command"
                Margin="380,232,5,45"
                Focusable="False"
                FontFamily="Courier New"
            />
            <Button
                x:Name="SkillsRemoveCommandButton"
                Style="{StaticResource BottingButtonStyle}" 
                Content="- Command"
                Margin="260,232,125,45"
                Focusable="False"
                FontFamily="Courier New"
            />

        </Grid>
    </Viewbox>
</Window>
